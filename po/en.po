#: src/wimm/core/risk.py:189
msgid "associati al progetto"
msgstr "linked to the project"

#: src/wimm/core/risk_table.py:57
msgid "Il server si ferma."
msgstr "The server stops."

#: src/wimm/core/risk_table.py:58
msgid "È in uso adesso: chi lo sta usando perde la connessione."
msgstr "It is in use right now: whoever is using it loses the connection."

#: src/wimm/core/risk_table.py:60
msgid "È in esecuzione in primo piano in un terminale: potresti interrompere un lavoro in corso."
msgstr "It is running in the foreground in a terminal: you might interrupt work in progress."

#: src/wimm/core/risk_table.py:63
msgid "La sessione dell'agente si chiude: il lavoro non salvato nella conversazione si perde."
msgstr "The agent session closes: unsaved work in the conversation is lost."

#: src/wimm/core/risk_table.py:68
msgid "Il browser si chiude senza la chiusura normale: alla riapertura ripristina le schede dal salvataggio automatico, che può essere indietro di qualche secondo."
msgstr "The browser closes without a normal shutdown: when reopened it restores the tabs from its automatic save, which may be a few seconds behind."

#: src/wimm/core/risk_table.py:71
msgid "Eventuali file non salvati possono andare persi."
msgstr "Any unsaved files may be lost."

#: src/wimm/core/risk_table.py:73
msgid "Il programma si ferma: ciò che ha in memoria e non ha salvato va perso. Se è un servizio, potrebbe riavviarsi da solo."
msgstr "The program stops: whatever it holds in memory and has not saved is lost. If it is a service, it might restart on its own."

#: src/wimm/core/risk_table.py:76
msgid "L'applicazione si chiude."
msgstr "The application closes."

#: src/wimm/core/risk_table.py:77
msgid "Sta lavorando adesso: l'operazione in corso si interrompe."
msgstr "It is working right now: the operation in progress is interrupted."

#: src/wimm/core/risk_table.py:79
msgid "Il daemon si ferma e riparte da solo alla prossima build, che sarà un po' più lenta."
msgstr "The daemon stops and starts again by itself on the next build, which will be a bit slower."

#: src/wimm/core/risk_table.py:82
msgid "L'editor lo rilancia da solo; per qualche secondo completamento e controlli non rispondono."
msgstr "The editor relaunches it by itself; for a few seconds completion and checks do not respond."

#: src/wimm/core/risk_table.py:86
msgid "L'emulatore si chiude senza spegnere il dispositivo: ciò che l'app in prova non ha salvato si perde."
msgstr "The emulator closes without shutting the device down: whatever the app under test has not saved is lost."

#: src/wimm/core/risk_table.py:90
msgid "La macchina virtuale si ferma di colpo, come staccando la corrente: lo stato del sistema ospite non salvato si perde e il disco virtuale può danneggiarsi."
msgstr "The virtual machine stops abruptly, as if the power were cut: the unsaved state of the guest system is lost and the virtual disk may be damaged."

#: src/wimm/core/risk_table.py:94
msgid "Il cluster locale si ferma: i carichi in esecuzione al suo interno si interrompono."
msgstr "The local cluster stops: the workloads running inside it are interrupted."

#: src/wimm/core/risk_table.py:97
msgid "Si chiudono tutte le finestre e le schede del terminale e i programmi al loro interno."
msgstr "All the terminal windows and tabs close, along with the programs inside them."

#: src/wimm/core/risk_table.py:99
msgid "Chiusura immediata senza salvataggio."
msgstr "Immediate shutdown without saving."

#: src/wimm/core/risk_table.py:100
msgid "Il container si ferma; dati e configurazione restano."
msgstr "The container stops; its data and configuration remain."

#: src/wimm/core/risk_table.py:102
msgid "Se il container non si ferma da solo, Docker lo termina dopo 10 secondi."
msgstr "If the container does not stop by itself, Docker ends it after 10 seconds."

#: src/wimm/core/risk_table.py:104
msgid "Il container riparte con la configurazione di prima."
msgstr "The container starts again with its previous configuration."

#: src/wimm/core/risk_table.py:106
msgid "Le modifiche fatte dentro il container fuori dai volumi si perdono."
msgstr "Changes made inside the container outside its volumes are lost."

#: src/wimm/core/risk_table.py:108
msgid "I container vengono rimossi; i volumi con i dati restano."
msgstr "The containers are removed; the volumes with the data remain."

#: src/wimm/core/risk_table.py:110
#, python-brace-format
msgid "I dati dei volumi {volumes} vengono cancellati in modo definitivo."
msgstr "The data in the volumes {volumes} is permanently deleted."

#: src/wimm/core/risk_table.py:112
msgid "Si riscarica dal registry quando serve."
msgstr "It is downloaded again from the registry when needed."

#: src/wimm/core/risk_table.py:114
msgid "Immagine costruita in locale, non è su un registry: per riaverla serve ricostruirla."
msgstr "Image built locally, not on a registry: to get it back you have to build it again."

#: src/wimm/core/risk_table.py:116
msgid "Le prossime build saranno più lente."
msgstr "The next builds will be slower."

#: src/wimm/core/risk_table.py:117
msgid "I dati del volume vengono cancellati in modo definitivo."
msgstr "The volume data is permanently deleted."

#: src/wimm/core/risk_table.py:118
msgid "I pacchetti si riscaricano quando servono."
msgstr "Packages are downloaded again when needed."

#: src/wimm/core/risk_table.py:119
msgid "I repository git si riscaricano quando servono."
msgstr "Git repositories are downloaded again when needed."

#: src/wimm/core/risk_table.py:120
msgid "Le prossime compilazioni saranno più lente."
msgstr "The next compilations will be slower."

#: src/wimm/core/risk_table.py:122
msgid "Le dipendenze si riscaricano e la prossima build sarà più lenta."
msgstr "Dependencies are downloaded again and the next build will be slower."

#: src/wimm/core/risk_table.py:124
msgid "I browser si riscaricano alla prossima esecuzione."
msgstr "Browsers are downloaded again the next time they run."

#: src/wimm/core/risk_table.py:126
msgid "Gli artefatti installati in locale con mvn install non si riscaricano da nessuna parte: per riaverli serve ricostruire i progetti."
msgstr "Artifacts installed locally with mvn install cannot be downloaded from anywhere: to get them back you need to rebuild the projects."

#: src/wimm/core/risk_table.py:130
msgid "Gli IDE JetBrains ricostruiscono gli indici al prossimo avvio: l'apertura dei progetti sarà più lenta."
msgstr "JetBrains IDEs rebuild their indexes at the next start: opening projects will be slower."

#: src/wimm/core/risk_table.py:134
msgid "Modelli di HuggingFace: si riscaricano quando servono, anche diversi GB."
msgstr "HuggingFace models: they download again when needed, often several GB."

#: src/wimm/core/risk_table.py:137
msgid "Modelli di ollama: si riscaricano con ollama pull, anche diversi GB. Quelli creati in locale con ollama create non si riscaricano da nessuna parte."
msgstr "ollama models: they download again with ollama pull, often several GB. Models you created locally with ollama create cannot be downloaded again."

#: src/wimm/core/risk_table.py:141
msgid "Gli emulatori Android vengono cancellati con le app e i dati al loro interno: non si recuperano. Chiudi prima gli emulatori aperti, altrimenti lo spazio torna libero solo quando si chiudono."
msgstr "Android emulators are deleted together with the apps and data inside them: they cannot be recovered. Close any running emulator first, otherwise the space is freed only when it closes."

#: src/wimm/core/risk_table.py:146
msgid "Piattaforme, build-tools e immagini di sistema si riscaricano con sdkmanager: finché non lo fai le build Android non funzionano."
msgstr "Platforms, build-tools and system images download again with sdkmanager: until you do, Android builds do not work."

#: src/wimm/core/risk_table.py:150
msgid "Questo tipo di cache non è stato classificato: potrebbe contenere dati che non si riscaricano."
msgstr "This cache type has not been classified: it may hold data that cannot be downloaded again."

#: src/wimm/core/risk_table.py:153
msgid "I file nel cestino vengono eliminati in modo definitivo."
msgstr "The files in the trash are permanently deleted."

#: src/wimm/core/risk_table.py:155
msgid "Serve reinstallare le dipendenze (npm install o uv sync) prima di usare il progetto."
msgstr "You need to reinstall the dependencies (npm install or uv sync) before using the project."

#: src/wimm/core/risk_table.py:158
#, python-brace-format
msgid "Per usare di nuovo il progetto serve ricostruire la cartella con {command}."
msgstr "To use the project again, rebuild the folder with {command}."

