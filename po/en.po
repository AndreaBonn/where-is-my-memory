#: src/wimm/core/risk.py:162
msgid "associati al progetto"
msgstr "linked to the project"

#: src/wimm/core/risk_table.py:34
msgid "Il server si ferma."
msgstr "The server stops."

#: src/wimm/core/risk_table.py:35
msgid "È in uso adesso: chi lo sta usando perde la connessione."
msgstr "It is in use right now: whoever is using it loses the connection."

#: src/wimm/core/risk_table.py:37
msgid "È in esecuzione in primo piano in un terminale: potresti interrompere un lavoro in corso."
msgstr "It is running in the foreground in a terminal: you might interrupt work in progress."

#: src/wimm/core/risk_table.py:40
msgid "La sessione dell'agente si chiude: il lavoro non salvato nella conversazione si perde."
msgstr "The agent session closes: unsaved work in the conversation is lost."

#: src/wimm/core/risk_table.py:45
msgid "Il browser si chiude senza la chiusura normale: alla riapertura ripristina le schede dal salvataggio automatico, che può essere indietro di qualche secondo."
msgstr "The browser closes without a normal shutdown: when reopened it restores the tabs from its automatic save, which may be a few seconds behind."

#: src/wimm/core/risk_table.py:48
msgid "Eventuali file non salvati possono andare persi."
msgstr "Any unsaved files may be lost."

#: src/wimm/core/risk_table.py:50
msgid "Il programma si ferma: ciò che ha in memoria e non ha salvato va perso. Se è un servizio, potrebbe riavviarsi da solo."
msgstr "The program stops: whatever it holds in memory and has not saved is lost. If it is a service, it might restart on its own."

#: src/wimm/core/risk_table.py:53
msgid "L'applicazione si chiude."
msgstr "The application closes."

#: src/wimm/core/risk_table.py:55
msgid "Si chiudono tutte le finestre e le schede del terminale e i programmi al loro interno."
msgstr "All the terminal windows and tabs close, along with the programs inside them."

#: src/wimm/core/risk_table.py:57
msgid "Chiusura immediata senza salvataggio."
msgstr "Immediate shutdown without saving."

#: src/wimm/core/risk_table.py:58
msgid "Il container si ferma; dati e configurazione restano."
msgstr "The container stops; its data and configuration remain."

#: src/wimm/core/risk_table.py:60
msgid "Se il container non si ferma da solo, Docker lo termina dopo 10 secondi."
msgstr "If the container does not stop by itself, Docker ends it after 10 seconds."

#: src/wimm/core/risk_table.py:62
msgid "Il container riparte con la configurazione di prima."
msgstr "The container starts again with its previous configuration."

#: src/wimm/core/risk_table.py:64
msgid "Le modifiche fatte dentro il container fuori dai volumi si perdono."
msgstr "Changes made inside the container outside its volumes are lost."

#: src/wimm/core/risk_table.py:66
msgid "I container vengono rimossi; i volumi con i dati restano."
msgstr "The containers are removed; the volumes with the data remain."

#: src/wimm/core/risk_table.py:68
#, python-brace-format
msgid "I dati dei volumi {volumes} vengono cancellati in modo definitivo."
msgstr "The data in the volumes {volumes} is permanently deleted."

#: src/wimm/core/risk_table.py:70
msgid "Si riscarica dal registry quando serve."
msgstr "It is downloaded again from the registry when needed."

#: src/wimm/core/risk_table.py:72
msgid "Immagine costruita in locale, non è su un registry: per riaverla serve ricostruirla."
msgstr "Image built locally, not on a registry: to get it back you have to build it again."

#: src/wimm/core/risk_table.py:74
msgid "Le prossime build saranno più lente."
msgstr "The next builds will be slower."

#: src/wimm/core/risk_table.py:75
msgid "I dati del volume vengono cancellati in modo definitivo."
msgstr "The volume data is permanently deleted."

#: src/wimm/core/risk_table.py:76
msgid "I pacchetti si riscaricano quando servono."
msgstr "Packages are downloaded again when needed."

#: src/wimm/core/risk_table.py:77
msgid "I file nel cestino vengono eliminati in modo definitivo."
msgstr "The files in the trash are permanently deleted."

#: src/wimm/core/risk_table.py:79
msgid "Serve reinstallare le dipendenze (npm install o uv sync) prima di usare il progetto."
msgstr "You need to reinstall the dependencies (npm install or uv sync) before using the project."

