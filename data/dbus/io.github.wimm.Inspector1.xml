<node>
  <!--
    Both methods return JSON with a top-level "schema" integer, the same for the
    snapshot and the disk report. Version 2 adds the DevDir "marker" field and
    widens the cache "kind" values from 5 to 17. Version 3 makes the memory
    breakdown always carry shared_tmpfs, kernel_unreclaimable, zram and zswap,
    and adds memory.video, a list of {vendor, used_bytes, total_bytes} kept
    outside the breakdown. Version 4 adds group.growth to every group, either
    null or {delta_bytes, span_s}: the sustained rise of the group's memory.
    The disk report keeps its shape and only carries the new number. Readers accept only the version they know: a
    document with another "schema" is rejected, never guessed.
  -->
  <interface name="io.github.wimm.Inspector1">
    <method name="GetSnapshot">
      <arg name="snapshot" type="s" direction="out"/>
    </method>
    <method name="GetDiskReport">
      <arg name="report" type="s" direction="out"/>
    </method>
    <property name="Version" type="s" access="read"/>
  </interface>
</node>
